script = ExtResource("1_mmheg")
id = &"C"
notice_text = "READ THIS BOARD BEFORE EVERY FILE.\nYOU LAST READ IT {N} FILES AGO."
cover_lines = Array[String](["Cover any extra eyes with more than two eyes.", "DO NOT cover a face that has no eyes.\nThey need to see.", "Cover any smile that does not fit the face.", "Cover any document line that talks to you.", "STAFF ARE NOT subjects. DO NOT cover them."])
