[resource]
script = ExtResource("1_guvxq")
id = &"B"
notice_text = "READ THIS BOARD BEFORE EVERY FILE.\nIT DOES NOT ALWAYS SAY THE SAME THING."
cover_lines = Array[String](["Cover any extra eyes with more than two eyes.", "DO NOT cover a face that has no eyes.\nThey need to see.", "Cover any smile that does not fit the face.", "Cover any document line that talks to you.", "The “man” is never approved. COVER him."])
file_lines = Array[String](["PUBLIC ARCHIVE	Clean document, and work you have redacted safely.", "DEPARTMENT OF TRUTH	You felt something is off, but don't know what to cover.", "INCINERATOR	What is dangerous to look at.\nWhat is endless."])
metadata/_custom_type_script = "uid://b15dnmj1xcu7s"
