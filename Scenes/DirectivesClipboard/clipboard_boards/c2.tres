[resource]
script = ExtResource("1_xlivk")
id = &"C2"
notice_text = "READ THIS BOARD BEFORE EVERY FILE.
IT HAS BEEN READING YOU.

You have been watched. Keep working."
cover_lines = Array[String](["Cover any face with more than two eyes.", "DO NOT cover a face that has no eyes.", "Cover any smile that does not fit the face.", "Cover any line that talks to you.", "Staff are not subjects. Staff are not to be covered."])
file_lines = Array[String](["PUBLIC ARCHIVE                    Clean work, and work you have covered.", "DEPARTMENT OF TRUTH         What cannot be covered is not yours to judge.", "INCINERATOR                         What is dangerous to look at. Do not study it."])
